{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/z99wE/soloknuckle/main/flags-schema.json",
  "title": "Soloknuckle Feature Flags",
  "description": "Feature flag configuration. Flags default to OFF. A flag may be enabled for everyone (true), or scoped by allowlist / rollout percentage (object form).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "allowlist": { "type": "array", "items": { "type": "string" } },
              "rolloutPercent": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "required": ["enabled"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": true
}