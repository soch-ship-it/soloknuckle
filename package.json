{
  "name": "soloknuckle",
  "version": "1.0.2",
  "description": "Production hygiene CLI — pre-flight checks, secret scanning, agent firewall, and rollback daemon for any project.",
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "soloknuckle": "dist/cli/index.js",
    "soloknuckle-mcp": "dist/cli/mcp-server.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "build:bin": "node scripts/build-binaries.mjs",
    "dev": "ts-node cli/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soch-ship-it/soloknuckle.git"
  },
  "keywords": [
    "production",
    "hygiene",
    "cli",
    "ai",
    "security",
    "linting",
    "quality",
    "pre-flight",
    "guardrails",
    "code-quality",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/soch-ship-it/soloknuckle/issues"
  },
  "homepage": "https://github.com/soch-ship-it/soloknuckle#readme",
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inquirer": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  }
}
